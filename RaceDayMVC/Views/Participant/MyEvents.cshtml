@model List<RaceEnrolment>
@{
    ViewData["Title"] = "My Events";
}
<div class="page-heading"><span class="eyebrow">PARTICIPANT</span><h1>My events</h1><p>All your race entries in one place.</p></div>
<div class="panel table-responsive">
    <table class="table table-hover">
        <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Race number</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td><a asp-controller="Home" asp-action="Details" asp-route-id="@entry.EventID" class="fw-bold">@entry.EventName</a></td>
                <td>@entry.EventDate.ToString("dd MMM yyyy")</td>
                <td>@entry.CategoryName</td>
                <td>@entry.RaceNumber</td>
                <td><span class="badge badge-@entry.Status.ToLowerInvariant()">@entry.Status</span></td>
                <td>
                    @if (entry.EventDate > DateTime.Now && entry.Status != "Cancelled")
                    {
                        <form asp-action="Cancel" method="post" onsubmit="return confirm('Withdraw from this event?');">
                            <input type="hidden" name="id" value="@entry.EnrolmentID" />
                            <button class="btn btn-outline-danger btn-sm">Withdraw</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (Model.Count == 0) { <div class="empty-state">No entries yet. <a asp-controller="Home" asp-action="Index">Find an event →</a></div> }
</div>
