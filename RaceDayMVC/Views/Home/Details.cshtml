@model EventDetail
@{
    ViewData["Title"] = Model.Event.EventName;
    bool isParticipant = Context.Session.GetString("Role") == "Participant";
}
<div class="mb-3"><a asp-action="Index" class="back-link">← All events</a></div>
@if (!string.IsNullOrEmpty(Model.Event.BannerUrl))
{
    <img class="detail-banner" src="@Model.Event.BannerUrl" alt="Banner for @Model.Event.EventName" />
}
<div class="page-heading">
    <span class="eyebrow">@Model.Event.EventType EVENT</span>
    <h1>@Model.Event.EventName</h1>
    <p>@Model.Event.Description</p>
</div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel">
            <h2 class="section-title">Choose your category</h2>
            @foreach (var category in Model.Categories)
            {
                <div class="category-row">
                    <div>
                        <strong>@category.CategoryName</strong>
                        <div class="text-muted small">@category.DistanceKm km · Max @category.MaxParticipants people</div>
                    </div>
                    <div class="d-flex gap-3 align-items-center">
                        <strong>R @category.EntryFee.ToString("N2")</strong>
                        @if (isParticipant && Model.Event.RegistrationDeadline > DateTime.Now)
                        {
                            <form asp-controller="Participant" asp-action="Enter" method="post">
                                <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                                <input type="hidden" name="categoryId" value="@category.CategoryID" />
                                <button class="btn btn-accent">Enter event</button>
                            </form>
                        }
                    </div>
                </div>
            }
            @if (!Model.Categories.Any()) { <p class="text-muted">Categories will be announced soon.</p> }
            @if (!isParticipant) { <p class="small text-muted mt-3">Log in as a Participant to enter this race.</p> }
            @if (Model.Event.RegistrationDeadline <= DateTime.Now) { <div class="alert alert-warning">Registration has closed.</div> }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel">
            <h3 class="h5 fw-bold">Event information</h3>
            <p>📅 @Model.Event.EventDate.ToString("dd MMM yyyy, HH:mm")</p>
            <p>📍 @Model.Event.Location</p>
            <p>🏅 @Model.Event.EventType</p>
            @if (Model.Event.DistanceKm.HasValue) { <p>📏 @Model.Event.DistanceKm km</p> }
            <p class="small text-muted">Registration closes @Model.Event.RegistrationDeadline.ToString("dd MMM yyyy")</p>
        </div>
    </div>
</div>
