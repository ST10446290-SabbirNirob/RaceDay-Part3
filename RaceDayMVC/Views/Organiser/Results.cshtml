@model List<RaceResult>
@{
    var ev = (RaceEvent)ViewBag.Event;
    var entries = (List<RaceEnrolment>)ViewBag.Entries;
    ViewData["Title"] = "Race Results";
}
<a asp-action="Events" class="back-link">← Back to events</a>
<div class="page-heading"><span class="eyebrow">@ev.EventName</span><h1>Record results</h1><p>Capture official finish times and finishing positions after the event.</p></div>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="panel">
            <h2 class="h4 section-title">Published results</h2>
            <div class="table-responsive">
                <table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Finish</th><th>Position</th></tr></thead><tbody>
                @foreach (var result in Model)
                {
                    <tr><td>@result.FirstName @result.LastName</td><td>@result.CategoryName</td><td>@result.FinishTime.ToString(@"hh\:mm\:ss")</td><td>@result.OverallPosition</td></tr>
                }
                </tbody></table>
            </div>
            @if (Model.Count == 0) { <p class="text-muted">No results recorded yet.</p> }
        </div>
    </div>
    <div class="col-lg-5">
        <div class="panel">
            <h2 class="h4 section-title">Enter a result</h2>
            @if (ev.EventDate > DateTime.Now)
            {
                <div class="alert alert-warning">Results can only be recorded after the event date.</div>
            }
            <form asp-action="RecordResult" method="post">
                <input type="hidden" name="eventId" value="@ev.EventID" />
                <div class="mb-3"><label class="form-label">Participant</label><select class="form-select" name="EnrolmentID" required>
                    <option value="">Select an enrolment</option>
                    @foreach (var entry in entries.Where(e => e.Status != "Cancelled" && !Model.Any(r => r.EnrolmentID == e.EnrolmentID)))
                    {
                        <option value="@entry.EnrolmentID">@entry.FirstName @entry.LastName — @entry.CategoryName</option>
                    }
                </select></div>
                <div class="mb-3"><label class="form-label">Finish time (hh:mm:ss)</label><input class="form-control" name="FinishTime" type="text" placeholder="01:25:30" required pattern="[0-9]{1,2}:[0-9]{2}:[0-9]{2}" /></div>
                <div class="mb-3"><label class="form-label">Overall position</label><input class="form-control" name="OverallPosition" type="number" min="1" /></div>
                <div class="mb-3"><label class="form-label">Category position</label><input class="form-control" name="CategoryPosition" type="number" min="1" /></div>
                <button class="btn btn-accent w-100" disabled="@(ev.EventDate > DateTime.Now)">Publish result</button>
            </form>
        </div>
    </div>
</div>
