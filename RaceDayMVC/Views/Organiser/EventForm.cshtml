@model EventForm
@{
    ViewData["Title"] = Model.EventID == 0 ? "Create Event" : "Edit Event";
}
<a asp-action="Events" class="back-link">← Back to events</a>
<div class="page-heading"><span class="eyebrow">ORGANISER</span><h1>@ViewData["Title"]</h1></div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel">
            <form asp-action="SaveEvent" method="post">
                <input asp-for="EventID" type="hidden" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="mb-3"><label asp-for="EventName" class="form-label">Event name</label><input asp-for="EventName" class="form-control" /></div>
                <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label">Event date and time</label><input asp-for="EventDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /></div>
                    <div class="col-md-6 mb-3"><label asp-for="RegistrationDeadline" class="form-label">Registration deadline</label><input asp-for="RegistrationDeadline" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /></div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div>
                    <div class="col-md-3 mb-3"><label asp-for="EventType" class="form-label">Sport</label>
                        <select asp-for="EventType" class="form-select">
                            <option>Running</option><option>Walking</option><option>Cycling</option>
                        </select>
                    </div>
                    <div class="col-md-3 mb-3"><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" /></div>
                </div>
                <button class="btn btn-accent">Save event</button>
            </form>
        </div>
    </div>
    @if (Model.EventID != 0)
    {
        <div class="col-lg-4">
            <div class="panel">
                <h3 class="h5 fw-bold">Event banner</h3>
                @if (!string.IsNullOrEmpty(Model.BannerUrl)) { <img src="@Model.BannerUrl" alt="Event banner" class="img-fluid rounded mb-3" /> }
                <form asp-action="UploadBanner" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="eventId" value="@Model.EventID" />
                    <input type="file" name="image" accept="image/png,image/jpeg,image/webp" class="form-control mb-2" required />
                    <div class="small text-muted mb-2">JPG, PNG or WebP, maximum 5 MB.</div>
                    <button class="btn btn-dark">Upload banner</button>
                </form>
            </div>
            <div class="panel mt-3">
                <a class="d-block mb-2" asp-action="Categories" asp-route-eventId="@Model.EventID">Manage categories →</a>
                <a class="d-block" asp-action="Enrolments" asp-route-eventId="@Model.EventID">View enrolments →</a>
            </div>
        </div>
    }
</div>
