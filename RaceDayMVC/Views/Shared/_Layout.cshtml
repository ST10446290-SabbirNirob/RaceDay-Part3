@{
    string? role = Context.Session.GetString("Role");
    string name = Context.Session.GetString("Name") ?? "Athlete";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark racer-nav">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><span class="brand-bolt">⚡</span> RACEDAY</a>
            <div class="d-flex flex-wrap gap-3 align-items-center">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Explore Events</a>
                @if (role == "Organiser")
                {
                    <a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Dashboard</a>
                    <a class="nav-link" asp-controller="Organiser" asp-action="Events">Manage Events</a>
                }
                @if (role == "Participant")
                {
                    <a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My Events</a>
                    <a class="nav-link" asp-controller="Participant" asp-action="MyResults">My Results</a>
                    <a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a>
                }
                @if (role == null)
                {
                    <a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Login">Log in</a>
                    <a class="btn btn-accent btn-sm" asp-controller="Auth" asp-action="Register">Join RaceDay</a>
                }
                else
                {
                    <span class="text-light small d-none d-md-inline">Hi, @name</span>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                        <button class="btn btn-outline-light btn-sm" type="submit">Log out</button>
                    </form>
                }
            </div>
        </div>
    </nav>
    <main class="container main-content">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success" role="alert">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-warning" role="alert">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="footer mt-5 py-4">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span>© @DateTime.Now.Year RaceDay · Your next finish line starts here.</span>
            <span>PROG6212 · Sabbir Mahmud Nirob · ST10446290</span>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
